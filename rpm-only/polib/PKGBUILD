pkgname="python3-polib"
pkgver="1.1.1" # renovate: datasource=pypi depName=polib
pkgrel="1"
pkgdesc="A library to manipulate gettext files"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('x86_64')
depends__yum=(
  "python3"
)
makedepends__yum=(
  "python3"
  "python3-setuptools"
)
source=("https://pypi.io/packages/source/p/polib/polib-${pkgver}.tar.gz")
sha256sums=(
  "e02c355ae5e054912e3b0d16febc56510eff7e49d60bf22aecb463bd2f2a2dfa"
)

build() {
  cd "${srcdir}/polib-${pkgver}"
  python3 setup.py build
}

package() {
  cd "${srcdir}/polib-${pkgver}"
  python3 setup.py install \
    --optimize=1 \
    --prefix=/usr \
    --root="${pkgdir}" \
    --skip-build
}
