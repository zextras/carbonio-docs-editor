pkgname="python3-polib"
pkgver="1.2.0" # renovate: datasource=pypi depName=polib
pkgrel="1"
pkgdesc="A library to manipulate gettext files"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('x86_64')
license=("MIT")
depends__yum=(
  "python3"
)
makedepends__yum=(
  "python3"
  "python3-setuptools"
)
source=(
  "https://pypi.io/packages/source/p/polib/polib-${pkgver}.tar.gz"
  )
sha256sums=(
  "f3ef94aefed6e183e342a8a269ae1fc4742ba193186ad76f175938621dbfc26b"
)

build() {
  cd "${srcdir}/polib-${pkgver}"
  python3 setup.py build
}

package() {
  cd "${srcdir}/polib-${pkgver}"
  python3 setup.py install \
    --optimize=1 \
    --prefix=/usr \
    --root="${pkgdir}" \
    --skip-build
}
