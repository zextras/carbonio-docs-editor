build() {
  curl -sL https://deb.nodesource.com/setup_lts.x | bash - ;
  apt-get -y install nodejs; 
  cd "${srcdir}/online-cp-${pkgver}-2"

  # Rebrand of static strings
  sed -i 's/Collabora Online Development Edition/Carbonio Docs/g' \
    $(grep -iIr "Collabora Online Development Edition" . | cut -d":" -f1)

  # Add zx spice
  patch -Np1 -i ../zextras-server.patch

  # Disable unit-tests
  sed -i "s/test cypress_test//" Makefile.am

  # Force /opt/zextras/docs/conf path and inject some sane defaults
  sed -Ei "s#COOLWSD_CONFIGDIR=.*#COOLWSD_CONFIGDIR=/opt/zextras/docs/conf#" configure.ac
  sed -Ei "s#COOLWSD_LOGLEVEL=.*#COOLWSD_LOGLEVEL=information#" configure.ac
  sed -Ei "s#COOLWSD_VERSION_HASH=.*#COOLWSD_VERSION_HASH=dist#" configure.ac
  sed -Ei "s#COOLWSD_LOG_TO_FILE=.*#COOLWSD_LOG_TO_FILE=true#" configure.ac
  sed -Ei "s#CLEANUP_COMMAND=.*#CLEANUP_COMMAND=true#" test/Makefile.am

  # use Zextras and Collabora Copyright label in about dialog
  sed -i "s/VENDOR/Collabora Productivity Limited.<br>Copyright © 2022, Zextras/g" \
    browser/html/cool.html.m4

  ./autogen.sh
  ./configure --prefix=/opt/zextras/docs \
    --build=x86_64-linux-gnu \
    --disable-debug \
    --disable-debug-protocol \
    --disable-setcap \
    --enable-ssl \
    --host=x86_64-linux-gnu \
    --localstatedir=/var \
    --sysconfdir=/opt/zextras/docs/conf \
    --with-app-branding=/tmp/theme/dist \
    --with-app-name="Carbonio Docs Editor" \
    --with-lo-path=/opt/zextras/docs/core \
    --with-logfile=/opt/zextras/docs/log/docs-editor.log \
    --with-lokit-path=/opt/zextras/common/include \
    --with-max-connections=10000 \
    --with-max-documents=10000 \
    --with-poco-includes=/opt/zextras/common/include \
    --with-poco-libs=/opt/zextras/common/lib \
    --with-user-id="${pkgname}"

  make build-nocheck -j"$(nproc)"
}

package() {
  cd "${srcdir}/online-cp-${pkgver}-2"

  make DESTDIR="${pkgdir}" install

  install -dm755 "${pkgdir}"/var/log
  install -dm755 "${pkgdir}"/var/cache/${pkgname}
  install -dm750 "${pkgdir}"/var/lib/${pkgname}
  install -Dm644 coolwsd.xml \
    "${pkgdir}/opt/zextras/docs/conf/coolwsd.xml"

  install -Dm755 "${srcdir}/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 "${srcdir}/${pkgname}.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}.service"

  install -Dm644 "${srcdir}/${pkgname}-sidecar.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"

  install -Dm755 "${srcdir}/${pkgname}.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"

  install -Dm 644 "${srcdir}/${pkgname}-setup.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/${pkgname}.sh"

  install -Dm 644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/docs/service-discover/intentions.json"

  install -Dm 644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/docs/service-discover/policies.json"

  install -Dm 644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/docs/service-discover/service-protocol.json"

  cp -r /tmp/theme/dist/* \
    "${pkgdir}/opt/zextras/docs/share/coolwsd/browser/dist"
  rm -rf "${pkgdir}/opt/zextras/docs/conf/apache2/"
  rm -rf "${pkgdir}/opt/zextras/docs/conf/nginx/"
}

preinst:apt() {
  if [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop "${pkgname}.service" >/dev/null || true
    deb-systemd-invoke stop "${pkgname}-sidecar.service" >/dev/null || true
  fi
}

postinst:apt() {
  case "$1" in
  configure)
    setcap cap_fowner,cap_chown,cap_mknod,cap_sys_chroot=ep /opt/zextras/docs/bin/coolforkit
    setcap cap_sys_admin=ep /opt/zextras/docs/bin/coolmount

    id -u ${pkgname} >/dev/null 2>&1 || adduser --quiet --system --group --home /opt/zextras/docs/ ${pkgname} 2>/dev/null
    mkdir -p /var/cache/carbonio-docs-server \
      && chown ${pkgname}: /var/cache/${pkgname}
    rm -rf /var/cache/coolwsd/*
    chown ${pkgname}: -R /opt/zextras/docs/conf/
    chmod 644 /opt/zextras/docs/conf/coolkitconfig.xcu

    if [ ! -d /opt/zextras/docs/log ]; then
      mkdir -p /opt/zextras/docs/log/
      chown ${pkgname}:${pkgname} -R /opt/zextras/docs/log/
	  fi
    rm -rf /opt/zextras/docs/generated/
    mkdir -p /opt/zextras/docs/generated/
    mkdir -p /opt/zextras/docs/generated/child-roots
    chown ${pkgname}: -R /opt/zextras/docs/generated/

    mkdir -p /opt/zextras/docs/core/share/fonts/custom
    fc-cache /opt/zextras/docs/core/share/fonts/

    su ${pkgname} --shell=/bin/sh -c "/opt/zextras/docs/bin/coolwsd-systemplate-setup /opt/zextras/docs/generated/systemplate /opt/zextras/docs/core/ >/dev/null 2>&1"
    su ${pkgname} --shell=/bin/sh -c "/opt/zextras/docs/bin/loolwsd-generate-proof-key >/dev/null 2>&1"

    if deb-systemd-helper --quiet was-enabled "${pkgname}.service"; then
      deb-systemd-helper enable "${pkgname}.service" >/dev/null || true
    else
      deb-systemd-helper update-state "${pkgname}.service" >/dev/null || true
    fi

    if deb-systemd-helper --quiet was-enabled "${pkgname}-sidecar.service"; then
      deb-systemd-helper enable "${pkgname}-sidecar.service" >/dev/null || true
    else
      deb-systemd-helper update-state "${pkgname}-sidecar.service" >/dev/null || true
    fi

    systemctl daemon-reload || true

    echo "======================================================"
    echo "Carbonio Docs Editor installed successfully!"
    echo "You must run pending-setups to configure it correctly."
    echo "======================================================"
    ;;
  esac
}
