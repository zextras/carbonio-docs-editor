_prepare() {
  cd "${srcdir}/online.mirror-cp-${pkgver}-${_pkgrel}"

  # Rocky/RHEL 8.10 silently rebuilt the default llvm-toolset:rhel8 module
  # stream (May 2026) to ship llvm-21 instead of llvm-17. llvm-21 drags
  # python3.12, which registers /usr/bin/python3 at a higher alternatives
  # priority than platform-python 3.6. The python3-lxml / python3-polib
  # packages bind to 3.6 only, so configure's AC_PYTHON check fails with
  # "lxml for python3 is needed". Restore python3 -> platform-python so the
  # configure macro finds the modules that are actually installed.
  if [ -x /usr/libexec/platform-python ] && command -v alternatives >/dev/null 2>&1; then
    # platform-python isn't registered as an alternative by default on Rocky
    # 8.10; --install first, then force-select it over python3.12.
    alternatives --install /usr/bin/python3 python3 \
      /usr/libexec/platform-python 99999 2>/dev/null || true
    alternatives --set python3 /usr/libexec/platform-python 2>/dev/null || true
  fi

  # Add zx spice
  patch -Np1 -i "${srcdir}/zextras-server.patch"

  # Backend patch (no longer assumes base url is without get parameters and removed broken last modification https://github.com/CollaboraOnline/online/issues/11050)
  patch -Np1 -i "${srcdir}/wopi-fixes.patch"

  # Rebrand of static strings
  sed -i 's/Collabora Online Development Edition/Carbonio Docs/g' \
    $(grep -iIr "Collabora Online Development Edition" . | cut -d":" -f1)

  # Force /opt/zextras/docs/conf path and inject some sane defaults
  sed -Ei "s#COOLWSD_CONFIGDIR=.*#COOLWSD_CONFIGDIR=/opt/zextras/docs/conf#" configure.ac
  sed -Ei "s#COOLWSD_LOGLEVEL=.*#COOLWSD_LOGLEVEL=information#" configure.ac
  sed -Ei "s#COOLWSD_VERSION_HASH=.*#COOLWSD_VERSION_HASH=dist#" configure.ac
  sed -Ei "s#COOLWSD_LOG_TO_FILE=.*#COOLWSD_LOG_TO_FILE=true#" configure.ac
  sed -Ei "s#CLEANUP_COMMAND=.*#CLEANUP_COMMAND=true#" test/Makefile.am

  # use Zextras and Collabora Copyright label in about dialog
  sed -i "s/VENDOR/Collabora Productivity Limited.<br>Copyright © 2025, Zextras/g" \
    browser/html/cool.html.m4

}

prepare__ubuntu_jammy() {
  cd "${srcdir}/online.mirror-cp-${pkgver}-${_pkgrel}"

  # Jammy's clang-14 lacks C++20 chrono formatters, so we need an
  # explicit operator<< for std::chrono::hours.
  patch -Np1 -i "${srcdir}/jammy-chrono-hours.patch"

  _prepare
}

prepare() {
  _prepare
}

build() {
  cd "${srcdir}/online.mirror-cp-${pkgver}-${_pkgrel}"

  # POCO, OpenSSL, expat, libpng and zstd are linked statically from the
  # engine build-tree subset shipped by carbonio-docs-core
  # (--with-lo-builddir below). OPENSSL_* bypasses the pkg-config probe so
  # the system/carbonio OpenSSL is never mixed in.
  # No `local`: yap runs build() bodies as top-level scripts.
  engine_ut=/opt/zextras/docs/engine/workdir/UnpackedTarball
  export OPENSSL_CFLAGS="-isystem ${engine_ut}/openssl/include"
  export OPENSSL_LIBS="-L${engine_ut}/openssl -lssl -lcrypto"

  export CC="clang -pthread"
  export CXX="clang++ -pthread"

  ./autogen.sh
  ./configure \
    --build=x86_64-linux-gnu \
    --disable-debug \
    --disable-debug-protocol \
    --disable-tests \
    --disable-werror \
    --enable-ssl \
    --host=x86_64-linux-gnu \
    --localstatedir=/var \
    --prefix=/opt/zextras/docs \
    --sysconfdir=/opt/zextras/docs/conf \
    --with-app-branding=/tmp/branding/dist \
    --with-app-name="Carbonio Docs Editor" \
    --with-dictionaries="" \
    --with-lo-path=/opt/zextras/docs/core \
    --with-logfile=/opt/zextras/docs/log/docs-editor.log \
    --with-lo-builddir=/opt/zextras/docs/engine \
    --with-lokit-path=/opt/zextras/common/include \
    --with-max-connections=10000 \
    --with-max-documents=10000 \
    --with-user-id="${pkgname}"

  make build-nocheck -j8
}

_package_common() {
  cd "${srcdir}/online.mirror-cp-${pkgver}-${_pkgrel}"

  make DESTDIR="${pkgdir}" install

  install -dm755 "${pkgdir}"/var/log
  install -dm755 "${pkgdir}"/var/cache/${pkgname}
  install -dm750 "${pkgdir}"/var/lib/${pkgname}
  install -Dm644 coolwsd.xml \
    "${pkgdir}/opt/zextras/docs/conf/coolwsd.xml"

  install -Dm755 "${srcdir}/${pkgname}" \
    "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 "${srcdir}/${pkgname}.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}.service"

  install -Dm755 "${srcdir}/${pkgname}-template.hcl" \
    "${pkgdir}/etc/zextras/service-discover/templates/${pkgname}-template.hcl"

  install -Dm644 "${srcdir}/521-${pkgname}.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/521-${pkgname}.sh"

  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/docs-editor/service-discover/intentions.json"

  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/docs-editor/service-discover/policies.json"

  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/docs-editor/service-discover/service-protocol.json"

  install -Dm644 "${srcdir}/carbonio-docs-routes-generator.py" \
    "${pkgdir}/usr/lib/carbonio-docs-routes-generator.py"

  cp -r "${srcdir}/branding/dist/"* \
    "${pkgdir}/opt/zextras/docs/share/coolwsd/browser/dist"
  rm -rf "${pkgdir}/opt/zextras/docs/conf/apache2/"
  rm -rf "${pkgdir}/opt/zextras/docs/conf/nginx/"
}

_package_systemd() {
  _package_common
  install -Dm644 "${srcdir}/${pkgname}-sidecar.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"
}

_package_legacy() {
  _package_common
  install -Dm644 "${srcdir}/${pkgname}-sidecar-legacy.service" \
    "${pkgdir}/lib/systemd/system/${pkgname}-sidecar.service"
}

package() {
  _package_systemd
}

package__rocky_8() {
  _package_legacy
}

package__ubuntu_jammy() {
  _package_legacy
}

preinst() {
  if [ -d /run/systemd/system ]; then
    systemctl stop carbonio-docs-editor.service >/dev/null 2>&1 || :
    systemctl stop carbonio-docs-editor-sidecar.service >/dev/null 2>&1 || :
  fi
}

postinst__apt() {
  case "$1" in
    configure)
      setcap cap_fowner,cap_chown,cap_mknod,cap_sys_chroot=ep /opt/zextras/docs/bin/coolforkit-caps
      setcap cap_sys_admin=ep /opt/zextras/docs/bin/coolmount

      id -u carbonio-docs-editor >/dev/null 2>&1 || adduser --quiet --system --group --home /opt/zextras/docs/ carbonio-docs-editor 2>/dev/null
      mkdir -p /var/cache/carbonio-docs-server \
        && chown carbonio-docs-editor: /var/cache/carbonio-docs-editor
      rm -rf /var/cache/coolwsd/*
      chown carbonio-docs-editor: -R /opt/zextras/docs/conf/
      chmod 644 /opt/zextras/docs/conf/coolkitconfig.xcu

      if [ ! -d /opt/zextras/docs/log ]; then
        mkdir -p /opt/zextras/docs/log/
      fi

      chown carbonio-docs-editor: -R /opt/zextras/docs/log/

      rm -rf /opt/zextras/docs/generated/
      mkdir -p /opt/zextras/docs/generated/
      mkdir -p /opt/zextras/docs/generated/child-roots
      chown carbonio-docs-editor: -R /opt/zextras/docs/generated/

      mkdir -p /opt/zextras/docs/core/share/fonts/custom
      fc-cache /opt/zextras/docs/core/share/fonts/

      su carbonio-docs-editor --shell=/bin/sh -c "/opt/zextras/docs/bin/coolwsd-systemplate-setup /opt/zextras/docs/generated/systemplate /opt/zextras/docs/core/ >/dev/null 2>&1"
      su carbonio-docs-editor --shell=/bin/sh -c "/opt/zextras/docs/bin/loolwsd-generate-proof-key >/dev/null 2>&1"

      if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || :
        systemctl enable carbonio-docs-editor.service >/dev/null 2>&1 || :
        systemctl enable carbonio-docs-editor-sidecar.service >/dev/null 2>&1 || :
      fi

      echo "======================================================"
      echo "Carbonio Docs Editor installed successfully!"
      echo "You must run pending-setups to configure it correctly."
      echo "======================================================"
      ;;
  esac
}

postinst__yum() {
  setcap cap_fowner,cap_chown,cap_mknod,cap_sys_chroot=ep /opt/zextras/docs/bin/coolforkit-caps
  setcap cap_sys_admin=ep /opt/zextras/docs/bin/coolmount

  id -u carbonio-docs-editor >/dev/null 2>&1 || adduser --system -U -d /opt/zextras/docs/ carbonio-docs-editor 2>/dev/null
  mkdir -p /var/cache/carbonio-docs-server \
    && chown carbonio-docs-editor: /var/cache/carbonio-docs-editor
  rm -rf /var/cache/coolwsd/*
  chown carbonio-docs-editor: -R /opt/zextras/docs/conf/
  chmod 644 /opt/zextras/docs/conf/coolkitconfig.xcu

  if [ ! -d /opt/zextras/docs/log ]; then
    mkdir -p /opt/zextras/docs/log/
  fi

  chown carbonio-docs-editor: -R /opt/zextras/docs/log/

  rm -rf /opt/zextras/docs/generated/
  mkdir -p /opt/zextras/docs/generated/
  mkdir -p /opt/zextras/docs/generated/child-roots
  chown carbonio-docs-editor: -R /opt/zextras/docs/generated/

  mkdir -p /opt/zextras/docs/core/share/fonts/custom
  fc-cache /opt/zextras/docs/core/share/fonts/
  su carbonio-docs-editor --shell=/bin/sh -c "/opt/zextras/docs/bin/coolwsd-systemplate-setup /opt/zextras/docs/generated/systemplate /opt/zextras/docs/core/ >/dev/null 2>&1"
  su carbonio-docs-editor --shell=/bin/sh -c "/opt/zextras/docs/bin/loolwsd-generate-proof-key >/dev/null 2>&1"

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-docs-editor.service >/dev/null 2>&1 || :
    systemctl enable carbonio-docs-editor-sidecar.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Docs Editor installed successfully!"
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-docs-editor.service >/dev/null 2>&1 || :
    systemctl --no-reload disable carbonio-docs-editor-sidecar.service >/dev/null 2>&1 || :
    systemctl stop carbonio-docs-editor.service >/dev/null 2>&1 || :
    systemctl stop carbonio-docs-editor-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
  if [ -f /etc/zextras/service-discover/carbonio-docs-editor.hcl ]; then
    rm -f /etc/zextras/service-discover/carbonio-docs-editor.hcl
  fi
}
