+        LOG_DBG("Authorization::authorizeURI - START");
+        LOG_DBG("Authorization::authorizeURI - Input URI: [" << uri.toString() << "]");
+        LOG_DBG("Authorization::authorizeURI - Input Path: [" << uri.getPath() << "]");
+        LOG_DBG("Authorization::authorizeURI - Input Query: [" << uri.getQuery() << "]");
