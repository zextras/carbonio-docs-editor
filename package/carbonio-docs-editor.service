[Unit]
Description=Carbonio Docs Server
After=network.target
PartOf=carbonio.target

[Service]
Environment="LANG=C.UTF-8"
ExecStart=/opt/zextras/docs/bin/coolwsd --version --o:sys_template_path=/opt/zextras/docs/generated/systemplate --o:child_root_path=/opt/zextras/docs/generated/child-roots --o:file_server_root_path=/opt/zextras/docs/share/coolwsd --port=10000
KillSignal=SIGINT
TimeoutStopSec=120
User=carbonio-docs-editor
KillMode=control-group
Restart=always
LimitNOFILE=infinity:infinity

ProtectSystem=strict
ReadWritePaths=/opt/zextras/docs /var/log

ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_FOWNER CAP_CHOWN CAP_MKNOD CAP_SYS_CHROOT CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
